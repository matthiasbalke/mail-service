# dev settings for local mailpit server
SMTP_USER=service@example.com
SMTP_PASSWORD=replace-with-your-password
SMTP_HOST=smtp.dev.example.com
# repository root: /local/certs
CERT_PATH=../local/certs
# make the node app accept the mkcert certificates
NODE_EXTRA_CA_CERTS=/tmp/ca.crt
# dev settings for local mailpit server


SMTP_PROFILES=primary,notifications
SMTP_DEFAULT_PROFILE=primary

SMTP_PRIMARY_HOST=smtp.example.com
SMTP_PRIMARY_PORT=587
SMTP_PRIMARY_SECURITY=starttls
SMTP_PRIMARY_USER=service@example.com
SMTP_PRIMARY_PASSWORD=replace-with-your-password
SMTP_PRIMARY_FROM=service@example.com
SMTP_PRIMARY_FROM_NAME=Mail Service
SMTP_PRIMARY_MAX_CONNECTIONS=5
SMTP_PRIMARY_MAX_MESSAGES=100
SMTP_PRIMARY_MAX_PENDING=1000

SMTP_NOTIFICATIONS_HOST=smtp.other.example
SMTP_NOTIFICATIONS_PORT=465
SMTP_NOTIFICATIONS_SECURITY=ssl
SMTP_NOTIFICATIONS_USER=notifications@example.org
SMTP_NOTIFICATIONS_PASSWORD=replace-with-another-password
SMTP_NOTIFICATIONS_FROM=notifications@example.org
SMTP_NOTIFICATIONS_FROM_NAME=Notifications
SMTP_NOTIFICATIONS_MAX_CONNECTIONS=10
SMTP_NOTIFICATIONS_MAX_MESSAGES=100
SMTP_NOTIFICATIONS_MAX_PENDING=2000

MAIL_SMTP_PROFILE=notifications
MAIL_TO=recipient@example.net
MAIL_SUBJECT=Service notification
MAIL_TEXT=Your report is ready.
